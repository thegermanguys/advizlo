# Postgres used by Prisma.
# DATABASE_URL is the runtime connection (Prisma Client / the API).
# DATABASE_URL_UNPOOLED is the direct connection (Prisma CLI: migrate, studio).
# Local Docker Postgres (docker compose up -d) uses the same database for both.
# Do not commit real hosted credentials. For Neon, replace these on the API
# host — see README section 2, "Hosted database (Neon)".
DATABASE_URL="postgresql://advizlo:advizlo@localhost:5432/advizlo?schema=public"
DATABASE_URL_UNPOOLED="postgresql://advizlo:advizlo@localhost:5432/advizlo?schema=public"

# Hosted Neon (placeholders only — paste real strings into the API host's env,
# not into git). From https://console.neon.tech → your project → Connect:
#   pooled string  → DATABASE_URL (hostname contains "-pooler")
#   direct string  → DATABASE_URL_UNPOOLED (no "-pooler")
# On the pooled URL only, keep sslmode=require and add pgbouncer=true and
# connect_timeout=15. Prisma 5's query engine needs pgbouncer=true because
# Neon's pooler is PgBouncer in transaction mode.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001

# Platform commission - fraction of the appointment fee taken on paid bookings.
# 0.15 = 15%. See product spec section 3 for the money-flow design.
COMMISSION_RATE=0.15

# Stripe - required for the payments module (Connect onboarding + Checkout).
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Get the webhook secret by running `stripe listen --forward-to localhost:3001/payments/webhook`
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Used to build Stripe redirect URLs (onboarding return/refresh, checkout success/cancel)
# and OAuth redirect URLs for the video integrations below.
WEB_APP_URL="http://localhost:3000"

# Daily.co - powers IN_APP_VIDEO rooms. No per-consultant setup needed, just
# a platform API key. Get one from https://dashboard.daily.co/developers
DAILY_API_KEY=""

# Zoom OAuth app - lets a consultant connect their own Zoom account so
# meetings get created under their name. Create an OAuth app at
# https://marketplace.zoom.us ("Build App" -> "OAuth", user-managed).
# Redirect URL to register there must exactly match ZOOM_REDIRECT_URI.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3001/video/zoom/callback"

# Google OAuth app - lets a consultant connect their Google account so Meet
# links get created via their Google Calendar. Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type
# "Web application") and enable the Google Calendar API for the project.
# Redirect URI to register there must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/video/google/callback"
