// Advizlo — full data model
// Run `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  CONSULTANT
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationMode {
  IN_APP_VIDEO
  ZOOM
  GOOGLE_MEET
  PHONE
  IN_PERSON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role     @default(CLIENT)
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultantProfile ConsultantProfile?
  bookingsAsClient  Booking[]          @relation("ClientBookings")
  reviews           Review[]
}

model Category {
  id                      String              @id @default(uuid())
  name                    String              @unique
  description             String?
  // Overrides the platform-wide COMMISSION_RATE for every consultant in this
  // category (e.g. medical consultants at a lower take rate than legal).
  // null = fall back to the global rate. See bookings.service.ts resolveCommissionRate.
  commissionRateOverride  Float?
  consultants             ConsultantProfile[]
}

model ConsultantProfile {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id])
  categoryId               String
  category                 Category           @relation(fields: [categoryId], references: [id])
  bio                      String?
  credentialsInfo          String?
  verificationStatus       VerificationStatus @default(PENDING)
  payoutAccountId          String? // Stripe Connect account id
  cancellationPolicyHours  Int                @default(24)
  inPersonAddress          String? // shown to clients when they book an IN_PERSON consultation
  // Highest-priority override: beats both the category override and the
  // global default when set. null = fall back to category, then global.
  commissionRateOverride   Float?
  // OAuth tokens for consultant-connected video providers. These are secrets -
  // never returned from public or self-profile endpoints (see
  // consultants.service.ts, which explicitly `select`s only safe fields).
  // Daily.co needs no per-consultant connection at all (platform API key),
  // which is why there's no dailyAccessToken here.
  zoomAccessToken          String?
  zoomRefreshToken         String?
  zoomTokenExpiresAt       DateTime?
  googleAccessToken        String?
  googleRefreshToken       String?
  googleTokenExpiresAt     DateTime?
  createdAt                DateTime           @default(now())

  serviceTypes ServiceType[]
  availability Availability[]
  bookings     Booking[]       @relation("ConsultantBookings")
}

model ServiceType {
  id                String             @id @default(uuid())
  consultantId      String
  consultant        ConsultantProfile  @relation(fields: [consultantId], references: [id])
  name              String
  durationMins      Int
  price             Decimal            @db.Decimal(10, 2)
  currency          String             @default("USD")
  isFirstFree       Boolean            @default(false)
  consultationModes ConsultationMode[]
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())

  bookings Booking[]
}

model Availability {
  id           String            @id @default(uuid())
  consultantId String
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id])
  dayOfWeek    Int? // 0=Sunday..6=Saturday, used when isRecurring = true
  specificDate DateTime? // used for one-off overrides / blocked days
  startTime    String // "09:00" 24h local to consultant timezone
  endTime      String // "17:00"
  isRecurring  Boolean           @default(true)
  isBlocked    Boolean           @default(false) // true = explicitly unavailable (vacation etc.)
}

model Booking {
  id               String            @id @default(uuid())
  clientId         String
  client           User              @relation("ClientBookings", fields: [clientId], references: [id])
  consultantId     String
  consultant       ConsultantProfile @relation("ConsultantBookings", fields: [consultantId], references: [id])
  serviceTypeId    String
  serviceType      ServiceType       @relation(fields: [serviceTypeId], references: [id])
  scheduledAt      DateTime
  durationMins     Int
  status           BookingStatus     @default(PENDING)
  consultationMode ConsultationMode
  meetingLink      String?
  address          String?
  priceCharged     Decimal           @db.Decimal(10, 2)
  commissionAmount Decimal           @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  payment Payment?
  review  Review?
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  platformFee      Decimal       @db.Decimal(10, 2)
  consultantPayout Decimal       @db.Decimal(10, 2)
  providerTxnId    String?
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  clientId  String
  client    User     @relation(fields: [clientId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
