{
  "expo": {
    "name": "Advizlo",
    "slug": "advizlo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiUrl": "http://localhost:3001"
    },
    "ios": { "supportsTablet": true },
    "android": {},
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Advizlo uses your photos so you can set a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
