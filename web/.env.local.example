# Public base URL of the Advizlo API, no trailing slash.
# Local: the Nest dev server. On the Vercel web project, set this to that
# project's production API origin, for example https://your-api-project.vercel.app
# The web project does not talk to Postgres. Leave DATABASE_URL and
# DATABASE_URL_UNPOOLED unset here; they belong on the Vercel API project.
NEXT_PUBLIC_API_URL=http://localhost:3001
